# ─────────────────────────────────────────────────────────────
# GrowthGrid — environment variables
# Copy to `.env.local` and fill in values as needed.
# ─────────────────────────────────────────────────────────────

# Public site URL — used for canonical URLs, sitemap, robots and OG images.
# Falls back to `url` in content/settings.json when unset.
NEXT_PUBLIC_SITE_URL=https://growthgrid.studio

# Where content is read from:
#   json  (default) → reads the files in /content
#   mongo           → reads from MongoDB (run `npm run seed` first)
CONTENT_SOURCE=json

# MongoDB connection string. Required when CONTENT_SOURCE=mongo.
# When set, contact-form leads are also stored in MongoDB.
MONGODB_URI=
MONGODB_DB=growthgrid

# ── Lead emails ───────────────────────────────────────────────
# Every contact-form enquiry is emailed to hello@growthgrid.studio and
# aarshitjolapara11@gmail.com. LEAD_EMAIL_TO can add further recipients
# (comma-separated). SMTP settings below are required to send mail.
# The submitter also receives an automatic confirmation. Reply in your mail
# app and it goes straight to them. If an enquiry can't be saved, the studio
# email is marked "Not saved".
#
# Sent over SMTP, so any mailbox works and only these values change:
#   Gmail             SMTP_HOST=smtp.gmail.com, SMTP_USER=you@gmail.com,
#                     SMTP_PASS=an App Password. Turn on 2-Step Verification,
#                     then create one at https://myaccount.google.com/apppasswords
#                     (your normal Gmail password is refused).
#   Google Workspace  smtp.gmail.com, hello@growthgrid.studio, an App Password
#   Zoho Mail (India) smtp.zoho.in, hello@growthgrid.studio, its password
#                     (an app-specific password when 2FA is on)
#   Resend            smtp.resend.com, user "resend", an API key as the
#                     password, and LEAD_EMAIL_FROM on a domain verified there
# SMTP_PORT: 465 (SSL, the default) or 587 (STARTTLS).
LEAD_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional sender, e.g. "growthGrid <hello@growthgrid.studio>" (with the
# quotes). Defaults to SMTP_USER; Gmail always sends as the signed-in address.
LEAD_EMAIL_FROM=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Optional.
# When set, a cookie-consent banner appears and GA only loads after
# the visitor accepts. When unset, no analytics code ships at all.
# The ID in Studio › Site settings › Analytics takes priority; this is
# the fallback when that field is empty.
NEXT_PUBLIC_GA_ID=

# ngrok — `npm run tunnel` shares the local dev server on a public HTTPS URL
# for testing on phones/tablets. Free token:
# https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Optional: your free static domain (e.g. my-name.ngrok-free.app) for a fixed URL.
NGROK_DOMAIN=

# ── Admin studio ──────────────────────────────────────────────
# The content editor (edits the JSON files in /content). Without a valid
# secret and at least one valid user it doesn't exist: every admin URL is
# a plain 404.
#
# Signs the login cookie, 32+ characters. Generate one with:
#   openssl rand -base64 48
# Changing it signs everyone out.
ADMIN_SESSION_SECRET=
# Optional private address instead of /admin: one URL segment of 3-64
# letters, digits or dashes, e.g. studio-x8k2. When set, /admin is a plain
# 404 and the studio only answers at https://your-site/studio-x8k2.
ADMIN_PATH=

# Studio users: one numbered block per person, ADMIN_1_… up to ADMIN_20_…
# (gaps are fine). Each person signs in with their EMAIL + PASSWORD, and
# NAME is shown in History next to every change they make.
#   PASSWORD  12+ characters. Changing it signs only that person out.
#             Next.js expands $ in .env values: write a literal $ as \$
#   ROLE      what they can do in the Studio (not their job title):
#             owner   everything, including site settings
#             editor  everything except site settings
#             writer  creates and edits content and page copy; can't
#                     delete, revoke, or change the homepage layout or
#                     settings
# A block with a mistake is skipped (the reason is logged, and shown on the
# login screen in development), so one typo can't lock everyone out.
ADMIN_1_NAME=
ADMIN_1_EMAIL=
ADMIN_1_PASSWORD=
ADMIN_1_ROLE=owner

ADMIN_2_NAME=
ADMIN_2_EMAIL=
ADMIN_2_PASSWORD=
ADMIN_2_ROLE=writer

# Older single-password sign-in (one owner account, password only). Only
# used when no ADMIN_<n>_ user is set.
# ADMIN_PASSWORD=

# ── File library ──────────────────────────────────────────────
# A private page that lists everything in /public with previews and
# downloads (one file, a folder, or all of it as a .zip). Its address
# appears nowhere in the code, it isn't linked from the site, it's never
# indexed, and /files itself is always a plain 404. Anyone who has the
# address can open it, so make it unguessable: one URL segment of 12-64
# letters, digits or dashes. Generate one with:
#   echo "files-$(openssl rand -hex 10)"
# The page is then at https://your-site/<that value>. Unset: no page.
FILES_PATH=
